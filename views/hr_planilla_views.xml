<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Agregar botón CSV de Planilla Única en hr.planilla.
             Los campos adicionales del tree se omiten porque el view padre
             no incluye un <tree> dentro de planilla_lines; los campos
             existen en el modelo y se usan desde Python para generar el CSV. -->
        <record id="hr_planilla_view_form_inherit_unica" model="ir.ui.view">
            <field name="name">hr.planilla.form.inherit.unica</field>
            <field name="model">hr.planilla</field>
            <field name="inherit_id" ref="treming_sv_payroll.view_form_hr_planilla"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_download_planilla_unica_csv"
                            string="Descargar CSV Planilla Única"
                            type="object"
                            class="btn-primary"
                            invisible="employer_type != 'unica'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
